# ============================================================================
# Relaunch-Pipeline – Konfiguration. Kopieren nach .env (lokal) bzw. als
# GitHub Secrets/Variables anlegen (Produktion). Alles Optionale darf leer bleiben:
# die jeweilige Stufe läuft dann im Dry-Run / degradiert mit klarer Meldung.
# ============================================================================

# --- Allgemein ---------------------------------------------------------------
ENV=dev                         # dev | prod | test
LOG_LEVEL=INFO
LOG_JSON=false                  # true in GitHub Actions (JSON-Zeilen)
DATABASE_URL=                   # leer = SQLite in data/pipeline.db. Produktion: postgres://... (Supabase, Pooler-URL, Port 6543)
TIMEZONE=Europe/Berlin

# --- Geschäft / Absender -----------------------------------------------------
INDUSTRY=fahrschulen            # Ordnername unter industries/
REGION_CITIES_FILE=config/cities_nrw.txt
SENDER_NAME="Vorname Nachname"
SENDER_TITLE=Webdesign
SENDER_ADDRESS="Musterstraße 1, 12345 Musterstadt"
SENDER_PHONE=
REPLY_TO_EMAIL=auguyoga@gmail.com   # NUR Empfänger für Antworten. Es wird nie von dieser Adresse versendet.
SETUP_PRICE=390                 # € einmalig (wird in Mails nicht genannt)
MONTHLY_PRICE=30                # € pro Monat (wird in Mails nicht genannt)
PREVIEW_DOMAIN=preview.diaktoros.de   # Hauptdomain für Previews (Cloudflare Pages Custom Domain), siehe docs/DOMAINS.md
PREVIEW_BASE_URL=               # optional, Default https://{PREVIEW_DOMAIN}
BRAND_NAME=Diaktoros            # optionaler Markenname im Preview-Banner (sonst SENDER_NAME)

# --- Discovery (Google Places API New) --------------------------------------
GOOGLE_PLACES_API_KEY=          # Google Cloud → APIs → "Places API (New)" aktivieren → API-Key (auf Places API beschränken)
PLACES_MAX_REQUESTS_PER_RUN=60  # Kostenbremse (Text Search ≈ 0,03 €/Request)
PLACES_PAGES_PER_QUERY=3        # 20 Treffer pro Seite
PLACES_CACHE_DAYS=30            # Google-ToS: Places-Inhalte max. 30 Tage cachen (place_id unbegrenzt)
CHAIN_MIN_LOCATIONS=3           # gleiche Domain an >= N Standorten = Kette → ausgeschlossen

# --- Scoring (PageSpeed Insights) --------------------------------------------
PAGESPEED_API_KEY=              # Google Cloud → "PageSpeed Insights API" → API-Key (kostenlos, ohne Key nur kleine Quote)
PAGESPEED_MAX_REQUESTS_PER_RUN=100
SCORE_THRESHOLD=55              # ab diesem Score (0-100) gilt eine Website als "messbar schlecht"
HTTP_TIMEOUT_SECONDS=20

# --- Kontakt / Verifizierung ---------------------------------------------------
MILLIONVERIFIER_API_KEY=        # optional (≈ 0,0003 €/Adresse). Ohne Key: nur Syntax + MX-Check
REQUIRE_VERIFIED_EMAIL=true     # true = unverifizierte Adressen werden NICHT an den Sequencer übergeben
MX_CHECK=true

# --- Extraktion ----------------------------------------------------------------
EXTRACT_MAX_PAGES=8
EXTRACT_USE_PLAYWRIGHT=true     # JS-Seiten rendern (braucht `playwright install chromium`)
EXTRACT_MAX_IMAGES=6

# --- Generierung (Anthropic) ---------------------------------------------------
ANTHROPIC_API_KEY=              # console.anthropic.com → API Keys. Ohne Key: regelbasierte Generierung
LLM_MODEL=claude-haiku-5-5      # günstigstes Claude-5-Modell; bei Qualitätsproblemen claude-sonnet-5-5
LLM_MAX_COST_PER_RUN_EUR=2.0
LLM_MAX_TOKENS=8000

# --- Preview-Deployment (Cloudflare Pages) -------------------------------------
CLOUDFLARE_API_TOKEN=           # Cloudflare → My Profile → API Tokens → Template "Cloudflare Pages: Edit" (Account-Scope)
CLOUDFLARE_ACCOUNT_ID=          # Cloudflare Dashboard → rechts "Account ID"
CLOUDFLARE_PAGES_PROJECT=relaunch-previews
PREVIEW_EXPIRE_DAYS=45          # Previews ohne Antwort werden danach entfernt (Status expired)

# --- Review --------------------------------------------------------------------
AUTO_APPROVE=false              # true = Leads OHNE Validator-Warnungen automatisch freigeben
REVIEW_HOST=127.0.0.1
REVIEW_PORT=8787

# --- Versand -------------------------------------------------------------------
SENDER_BACKEND=dryrun           # dryrun (.eml nach outbox/) | instantly
INSTANTLY_API_KEY=              # Instantly → Settings → Integrations → API Keys (v2)
INSTANTLY_CAMPAIGN_ID=          # ID der Kampagne (URL in Instantly), Sequenz-Schritte nutzen {{body_1}}, {{body_2}}, {{body_3}}
DAILY_SEND_LIMIT_START=30       # Leads pro Tag an den Sequencer (Start)
DAILY_SEND_LIMIT_MAX=150
DAILY_SEND_LIMIT_RAMP_PER_WEEK=20
SEND_WINDOW_START_HOUR=8        # Mo–Fr 8–17 Uhr Europe/Berlin
SEND_WINDOW_END_HOUR=17
SEND_WEEKDAYS_ONLY=true
FOLLOWUP_1_DAYS=3
FOLLOWUP_2_DAYS=7

# --- Bericht (optional per E-Mail über Resend) ---------------------------------
RESEND_API_KEY=                 # resend.com (3.000 Mails/Monat gratis). Absender-Domain muss dort verifiziert sein
REPORT_EMAIL_TO=                # z. B. auguyoga@gmail.com (Empfänger)
REPORT_EMAIL_FROM=              # z. B. pipeline@berichte.deine-domain.de – NIE die Antwortadresse

# --- Kostenannahmen für den Bericht (€) ------------------------------------------
COST_PLACES_PER_REQUEST_EUR=0.030
COST_PAGESPEED_PER_REQUEST_EUR=0
COST_LLM_INPUT_PER_MTOK_EUR=0.10
COST_LLM_OUTPUT_PER_MTOK_EUR=0.50
