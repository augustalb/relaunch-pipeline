---
// Fahrschule one-pager. Renders ONLY what exists in `content`; empty sections are hidden.
import type { SiteContent, PreviewMeta } from '../../../site/src/lib/types';
interface Props { content: SiteContent; meta: PreviewMeta }
const { content: c, meta } = Astro.props;

const name = c.company_name.value;
const phone = c.contact.phone?.value;
const phoneHref = phone ? 'tel:' + phone.replace(/[^\d+]/g, '') : undefined;
const email = c.contact.email?.value;
const address = c.contact.address?.value;
const hero = c.hero_image || undefined;
const logo = c.images.find((i) => i.role === 'logo');
const gallery = c.images.filter((i) => i.role !== 'logo' && i.url !== hero).slice(0, 3);
const show = {
  highlights: c.highlights.length > 0,
  services: c.services.length > 0,
  prices: c.prices.length > 0,
  hours: c.hours.length > 0,
  team: c.team.length > 0,
  about: !!c.about,
  contact: !!(phone || email || address),
};
const nav = [
  show.services && { href: '#klassen', label: 'Klassen' },
  show.prices && { href: '#preise', label: 'Preise' },
  show.hours && { href: '#zeiten', label: 'Zeiten' },
  show.team && { href: '#team', label: 'Team' },
  show.about && { href: '#ueber-uns', label: 'Über uns' },
  show.contact && { href: '#kontakt', label: 'Kontakt' },
].filter(Boolean) as { href: string; label: string }[];
const initials = (n: string) => n.split(/\s+/).map((p) => p[0]).slice(0, 2).join('').toUpperCase();
const icons = ['M12 2 2 7l10 5 10-5-10-5Zm0 10v10M2 7v10l10 5 10-5V7', 'M12 8v4l3 3m6-3a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z', 'M5 13l4 4L19 7', 'M3 10h18M7 3v4m10-4v4M5 7h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2Z'];
const classBadge = (v: string) => v.replace(/^Klasse\s+/i, '');
---
<header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/85 backdrop-blur supports-[backdrop-filter]:bg-white/70" style={meta.mode === 'preview' ? 'top:var(--banner-h,41px)' : ''}>
  <div class="container-x flex h-16 items-center justify-between gap-4">
    <a href="#top" class="flex min-w-0 items-center gap-3">
      {logo ? <img src={logo.url} alt={logo.alt || name} class="h-9 w-auto max-w-[140px] object-contain" loading="eager" /> : <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-brand text-sm font-black text-white">{initials(name)}</span>}
      <span class="truncate text-base font-extrabold tracking-tight sm:text-lg">{name}</span>
    </a>
    <nav class="hidden items-center gap-6 text-sm font-semibold text-slate-600 md:flex" aria-label="Hauptnavigation">
      {nav.map((n) => <a class="hover:text-brand" href={n.href}>{n.label}</a>)}
    </nav>
    {phoneHref && <a href={phoneHref} class="btn-primary !px-4 !py-2 text-sm"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z"/></svg><span class="hidden sm:inline">Anrufen</span><span class="sm:hidden">Anruf</span></a>}
  </div>
</header>

<main id="top">
  <!-- HERO -->
  <section class="relative isolate overflow-hidden bg-brand-dark text-white">
    {hero && <img src={hero} alt="" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="eager" fetchpriority="high" />}
    <div class="absolute inset-0 -z-10 bg-gradient-to-br from-brand-dark/90 via-brand-dark/75 to-brand/45"></div>
    <div class="container-x grid gap-10 py-20 sm:py-28 lg:grid-cols-[1.2fr_1fr] lg:items-center lg:py-36">
      <div>
        <p class="eyebrow !text-white/80">{c.city ? `Fahrschule in ${c.city}` : 'Fahrschule'}</p>
        <h1 class="mt-4 text-4xl font-black leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">{c.tagline}</h1>
        <p class="mt-6 max-w-xl text-lg text-white/85 sm:text-xl">{c.hero_text}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          {phoneHref ? <a href={phoneHref} class="btn bg-accent text-ink shadow-lg shadow-black/20 hover:brightness-95">{c.cta_primary}</a> : show.contact ? <a href="#kontakt" class="btn bg-accent text-ink shadow-lg shadow-black/20 hover:brightness-95">{c.cta_primary}</a> : null}
          {show.services && <a href="#klassen" class="btn-ghost">Führerscheinklassen</a>}
        </div>
        {show.highlights && (
          <ul class="mt-10 grid gap-3 text-sm font-semibold text-white/90 sm:grid-cols-2">
            {c.highlights.map((h) => <li class="flex items-start gap-2"><svg class="mt-0.5 h-5 w-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg><span>{h}</span></li>)}
          </ul>
        )}
      </div>
      {(phone || address || show.hours) && (
        <aside class="rounded-3xl bg-white/10 p-6 ring-1 ring-white/20 backdrop-blur-md sm:p-8">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-white/70">Direkt erreichbar</p>
          <dl class="mt-4 space-y-4 text-white">
            {phone && <div><dt class="text-sm text-white/70">Telefon</dt><dd class="text-xl font-extrabold"><a href={phoneHref}>{phone}</a></dd></div>}
            {address && <div><dt class="text-sm text-white/70">Adresse</dt><dd class="font-semibold">{address}</dd></div>}
            {c.hours[0] && <div><dt class="text-sm text-white/70">{c.hours[0].label}</dt><dd class="font-semibold">{c.hours[0].entries.slice(0, 2).map((e) => <div>{e.value}</div>)}</dd></div>}
          </dl>
          {email && <a href={`mailto:${email}`} class="btn-light mt-6 w-full">E-Mail schreiben</a>}
        </aside>
      )}
    </div>
  </section>

  <!-- SERVICES -->
  {show.services && (
    <section id="klassen" class="section">
      <div class="container-x">
        <p class="eyebrow">Führerscheinklassen</p>
        <h2 class="h2">Das bilden wir aus</h2>
        <p class="lead">Von Roller bis Lkw, Schaltung oder Automatik. Sprechen Sie uns an, wir beraten Sie zur passenden Klasse.</p>
        <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {c.services.map((s) => (
            <li class="card flex flex-col gap-3 transition hover:-translate-y-0.5 hover:shadow-md">
              <div class="flex items-center justify-between gap-3">
                <span class="inline-flex h-12 min-w-12 items-center justify-center rounded-xl bg-brand px-3 text-lg font-black text-white">{classBadge(s.name.value)}</span>
                {s.price && <span class="rounded-full bg-brand-soft px-3 py-1 text-sm font-bold text-brand">{s.price.value}</span>}
              </div>
              <h3 class="text-lg font-extrabold">{s.name.value}</h3>
              {s.description && <p class="text-slate-600">{s.description}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- PRICES -->
  {show.prices && (
    <section id="preise" class="section bg-brand-soft/60">
      <div class="container-x">
        <p class="eyebrow">Preise</p>
        <h2 class="h2">Transparent und fair</h2>
        {c.price_note && <p class="lead">{c.price_note}</p>}
        <div class="card mt-10 divide-y divide-slate-100 !p-0">
          {c.prices.map((p) => (
            <div class="flex items-center justify-between gap-6 px-6 py-4">
              <span class="font-semibold">{p.label.value}</span>
              <span class="whitespace-nowrap text-lg font-extrabold text-brand">{p.price.value}</span>
            </div>
          ))}
        </div>
        <p class="mt-4 text-sm text-slate-600">Alle Preise laut aktueller Preisliste der Fahrschule. Die vollständige Preisliste liegt zur Einsicht aus.</p>
      </div>
    </section>
  )}

  <!-- HOURS -->
  {show.hours && (
    <section id="zeiten" class="section">
      <div class="container-x">
        <p class="eyebrow">Zeiten</p>
        <h2 class="h2">Wann Sie uns erreichen</h2>
        <div class="mt-10 grid gap-5 md:grid-cols-2">
          {c.hours.map((h, i) => (
            <div class="card">
              <div class="flex items-center gap-3">
                <span class="grid h-10 w-10 place-items-center rounded-xl bg-brand-soft text-brand"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[(i + 1) % icons.length]}/></svg></span>
                <h3 class="text-lg font-extrabold">{h.label}</h3>
              </div>
              <ul class="mt-4 space-y-2 text-slate-700">
                {h.entries.map((e) => <li class="flex justify-between gap-4 border-b border-slate-100 pb-2 last:border-0"><span>{e.value}</span></li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- TEAM -->
  {show.team && (
    <section id="team" class="section bg-slate-50">
      <div class="container-x">
        <p class="eyebrow">Team</p>
        <h2 class="h2">Wer Sie begleitet</h2>
        <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {c.team.map((m) => (
            <li class="card flex items-center gap-4">
              <span class="grid h-14 w-14 shrink-0 place-items-center rounded-full bg-brand text-lg font-black text-white">{initials(m.name.value)}</span>
              <div><p class="font-extrabold">{m.name.value}</p>{m.role && <p class="text-sm text-slate-600">{m.role}</p>}</div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ABOUT -->
  {show.about && (
    <section id="ueber-uns" class="section">
      <div class="container-x grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="eyebrow">Über uns</p>
          <h2 class="h2">{name}</h2>
          <p class="mt-6 text-lg leading-relaxed text-slate-700">{c.about}</p>
        </div>
        {gallery.length > 0 ? (
          <div class="grid grid-cols-2 gap-4">
            {gallery.map((g, i) => <img src={g.url} alt={g.alt} loading="lazy" class={`h-48 w-full rounded-2xl object-cover ring-1 ring-slate-200 ${i === 0 ? 'col-span-2 h-64' : ''}`} />)}
          </div>
        ) : (
          <div class="rounded-3xl bg-brand-soft p-8">
            <ul class="space-y-4 text-slate-700">
              {(c.highlights.length ? c.highlights : ['Persönliche Betreuung', 'Moderne Ausbildung']).map((h) => <li class="flex items-start gap-3"><span class="mt-1 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-brand text-white"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg></span><span class="font-semibold">{h}</span></li>)}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- CONTACT -->
  {show.contact && (
    <section id="kontakt" class="section bg-brand-dark text-white">
      <div class="container-x grid gap-10 lg:grid-cols-[1fr_1fr]">
        <div>
          <p class="eyebrow !text-white/70">Kontakt</p>
          <h2 class="h2 !text-white">Lust, loszufahren?</h2>
          <p class="mt-4 max-w-xl text-lg text-white/80">Rufen Sie an oder schreiben Sie uns. Wir melden uns schnellstmöglich und klären alle Fragen zur Anmeldung.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            {phoneHref && <a href={phoneHref} class="btn bg-accent text-ink hover:brightness-95">Jetzt anrufen</a>}
            {email && <a href={`mailto:${email}`} class="btn-ghost">E-Mail schreiben</a>}
          </div>
        </div>
        <dl class="grid gap-6 sm:grid-cols-2">
          {phone && <div class="rounded-2xl bg-white/10 p-5 ring-1 ring-white/15"><dt class="text-sm text-white/70">Telefon</dt><dd class="mt-1 text-lg font-extrabold"><a href={phoneHref}>{phone}</a></dd></div>}
          {email && <div class="rounded-2xl bg-white/10 p-5 ring-1 ring-white/15"><dt class="text-sm text-white/70">E-Mail</dt><dd class="mt-1 break-all text-lg font-extrabold"><a href={`mailto:${email}`}>{email}</a></dd></div>}
          {address && <div class="rounded-2xl bg-white/10 p-5 ring-1 ring-white/15 sm:col-span-2"><dt class="text-sm text-white/70">Adresse</dt><dd class="mt-1 text-lg font-extrabold">{address}</dd></div>}
          {c.contact.whatsapp && <div class="rounded-2xl bg-white/10 p-5 ring-1 ring-white/15"><dt class="text-sm text-white/70">WhatsApp</dt><dd class="mt-1 text-lg font-extrabold">{c.contact.whatsapp.value}</dd></div>}
        </dl>
      </div>
    </section>
  )}
</main>

<footer class="border-t border-slate-200 bg-white">
  <div class="container-x flex flex-col items-start justify-between gap-4 py-8 text-sm text-slate-500 sm:flex-row sm:items-center">
    <p><span class="font-bold text-ink">{name}</span>{address && <span> · {address}</span>}</p>
    <nav class="flex gap-5" aria-label="Rechtliches">
      <a class="hover:text-brand" href={meta.imprint_url || '#'}>Impressum</a>
      <a class="hover:text-brand" href={meta.privacy_url || '#'}>Datenschutz</a>
    </nav>
  </div>
</footer>
